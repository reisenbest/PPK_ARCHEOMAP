/* Основной фон */
QWidget {
    background-color: #C0C0C0;
    color: black;
    font-family: "MS Shell Dlg 2", "Tahoma", sans-serif;
    font-size: 10pt;
}

/* Кнопки */
QPushButton {
    background-color: #C0C0C0;
    border: 2px outset #ffffff;
    padding: 2px 6px;
    min-width: 60px;
}

QPushButton:pressed {
    border: 2px inset #808080;
}

/* Поля ввода */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: white;
    border: 2px inset #808080;
    padding: 2px;
}

/* Групповые рамки */
QGroupBox {
    border: 2px groove #808080;
    margin-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
}

/* Таблицы */
QTableView {
    background-color: white;
    border: 2px inset #808080;
    gridline-color: #A0A0A0;
}

QHeaderView::section {
    background-color: #C0C0C0;
    padding: 4px;
    border: 1px solid #A0A0A0;
}

/* Панель вкладок */
QTabWidget::pane {
    border: 2px outset #808080;
}

QTabBar::tab {
    background: #C0C0C0;
    border: 2px outset #808080;
    padding: 4px 8px;
}

QTabBar::tab:selected {
    background: #E0E0E0;
    border: 2px inset #808080;
}

/* Прогрессбары */
QProgressBar {
    border: 2px inset #808080;
    text-align: center;
    background: white;
}

QProgressBar::chunk {
    background-color: #000080;
}